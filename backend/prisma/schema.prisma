generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model cart_items {
  id         Int       @id @default(autoincrement())
  user_id    Int
  product_id Int
  quantity   Int       @default(1)
  size       String?   @db.VarChar(50)
  color      String?   @db.VarChar(50)
  created_at DateTime? @default(now()) @db.Timestamp(0)
  updated_at DateTime? @default(now()) @db.Timestamp(0)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "cart_items_ibfk_1")
  products   products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "cart_items_ibfk_2")

  @@unique([user_id, product_id, size, color], map: "unique_cart_item")
  @@index([user_id], map: "idx_cart_items_user")
  @@index([product_id], map: "product_id")
}

model categories {
  id          Int        @id @default(autoincrement())
  name        String     @db.VarChar(100)
  slug        String     @unique(map: "slug") @db.VarChar(100)
  description String?    @db.Text
  image_url   String?    @db.VarChar(255)
  is_active   Boolean?   @default(true)
  sort_order  Int?       @default(0)
  created_at  DateTime?  @default(now()) @db.Timestamp(0)
  updated_at  DateTime?  @default(now()) @db.Timestamp(0)
  products    products[]
}

model order_items {
  id          Int       @id @default(autoincrement())
  order_id    Int
  product_id  Int
  quantity    Int
  unit_price  Decimal   @db.Decimal(10, 2)
  size        String?   @db.VarChar(50)
  color       String?   @db.VarChar(50)
  total_price Decimal   @db.Decimal(10, 2)
  created_at  DateTime? @default(now()) @db.Timestamp(0)
  orders      orders    @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "order_items_ibfk_1")
  products    products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "order_items_ibfk_2")

  @@index([order_id], map: "idx_order_items_order")
  @@index([product_id], map: "product_id")
}

model orders {
  id                   Int                    @id @default(autoincrement())
  order_number         String                 @unique(map: "order_number") @db.VarChar(50)
  user_id              Int
  total_amount         Decimal                @db.Decimal(10, 2)
  status               orders_status?         @default(pending)
  payment_method       orders_payment_method
  payment_status       orders_payment_status? @default(pending)
  whatsapp_sent        Boolean?               @default(false)
  shipping_address     String                 @db.Text
  shipping_city        String                 @db.VarChar(100)
  shipping_postal_code String?                @db.VarChar(20)
  customer_notes       String?                @db.Text
  admin_notes          String?                @db.Text
  created_at           DateTime?              @default(now()) @db.Timestamp(0)
  updated_at           DateTime?              @default(now()) @db.Timestamp(0)
  order_items          order_items[]
  users                users                  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "orders_ibfk_1")

  @@index([status], map: "idx_orders_status")
  @@index([user_id], map: "idx_orders_user")
}

model product_images {
  id         Int       @id @default(autoincrement())
  product_id Int
  image_url  String    @db.VarChar(255)
  alt_text   String?   @db.VarChar(255)
  is_primary Boolean?  @default(false)
  sort_order Int?      @default(0)
  created_at DateTime? @default(now()) @db.Timestamp(0)
  products   products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "product_images_ibfk_1")

  @@index([product_id], map: "product_id")
}

model product_variants {
  id               Int                           @id @default(autoincrement())
  product_id       Int
  variant_type     product_variants_variant_type
  variant_value    String                        @db.VarChar(50)
  additional_price Decimal?                      @default(0.00) @db.Decimal(10, 2)
  stock_quantity   Int?                          @default(0)
  is_available     Boolean?                      @default(true)
  created_at       DateTime?                     @default(now()) @db.Timestamp(0)
  products         products                      @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "product_variants_ibfk_1")

  @@unique([product_id, variant_type, variant_value], map: "unique_product_variant")
}

model products {
  id               Int                @id @default(autoincrement())
  product_code     String             @unique(map: "product_code") @db.VarChar(50)
  name             String             @db.VarChar(255)
  slug             String             @unique(map: "slug") @db.VarChar(255)
  description      String?            @db.Text
  category_id      Int
  price            Decimal            @db.Decimal(10, 2)
  discount_price   Decimal?           @db.Decimal(10, 2)
  stock_quantity   Int?               @default(0)
  min_stock_level  Int?               @default(5)
  is_featured      Boolean?           @default(false)
  is_active        Boolean?           @default(true)
  meta_title       String?            @db.VarChar(255)
  meta_description String?            @db.Text
  created_at       DateTime?          @default(now()) @db.Timestamp(0)
  updated_at       DateTime?          @default(now()) @db.Timestamp(0)
  cart_items       cart_items[]
  order_items      order_items[]
  product_images   product_images[]
  product_variants product_variants[]
  categories       categories         @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "products_ibfk_1")

  @@index([is_active], map: "idx_products_active")
  @@index([category_id], map: "idx_products_category")
  @@index([is_featured], map: "idx_products_featured")
}

model users {
  id          Int          @id @default(autoincrement())
  email       String       @unique(map: "email") @db.VarChar(255)
  password    String       @db.VarChar(255)
  first_name  String       @db.VarChar(100)
  last_name   String       @db.VarChar(100)
  phone       String?      @db.VarChar(20)
  address     String?      @db.Text
  city        String?      @db.VarChar(100)
  postal_code String?      @db.VarChar(20)
  role        users_role?  @default(customer)
  is_active   Boolean?     @default(true)
  created_at  DateTime?    @default(now()) @db.Timestamp(0)
  updated_at  DateTime?    @default(now()) @db.Timestamp(0)
  cart_items  cart_items[]
  orders      orders[]
}

enum product_variants_variant_type {
  size
  color
}

enum orders_status {
  pending
  confirmed
  processing
  shipped
  delivered
  cancelled
}

enum orders_payment_method {
  bank_transfer
  cash_on_delivery
}

enum orders_payment_status {
  pending
  paid
  failed
}

enum users_role {
  customer
  admin
}
